# cp .env.example .env.local
# API 서버 주소. /api를 포함한 요청 경로를 이 주소 뒤에 붙인다.
# 예: https://example.com/backend + /api/projects -> https://example.com/backend/api/projects
VITE_API_BASE_URL=http://localhost:3000

# MSW 사용 여부 ("true" | "false"). 미설정 시 개발 true, production build false.
# .env.local은 production build에도 적용되므로 데모 배포에서만 명시적으로 true를 지정한다.
# 실제 API 연결: VITE_ENABLE_MOCKS=false
# VITE_ENABLE_MOCKS=true
